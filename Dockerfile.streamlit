# Use an official Python runtime as a parent image
FROM python:3.11-slim

# Set the working directory in the container
WORKDIR /myapp

# Set environment variables to ignore SSL verification
ENV PYTHONWARNINGS="ignore:Unverified HTTPS request"
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONHTTPSVERIFY=0

# Install development libraries and SSL certificates
RUN apt-get update --fix-missing && apt-get install -y \
    libpq-dev \
    gcc \
    ca-certificates \
    && apt-get clean \
    && update-ca-certificates

# Copy requirements file
COPY ./requirements_streamlit.txt /myapp/requirements_streamlit.txt

# Upgrade pip and setuptools with SSL verification disabled
RUN pip config set global.trusted-host "pypi.org files.pythonhosted.org" && \
    pip install --no-cache-dir --upgrade pip setuptools

# Install dependencies with SSL verification disabled
RUN pip --no-cache-dir install -r requirements_streamlit.txt

# Copy only the visualization directory into the container
COPY ./visualization /myapp/visualization
COPY .env.streamlit /myapp/.env.streamlit

# Expose port 8501 for Streamlit
EXPOSE 8501

# Run Streamlit app by default
CMD ["streamlit", "run", "/myapp/visualization/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
